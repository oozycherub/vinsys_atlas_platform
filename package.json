{
  "name": "atlas-platform",
  "private": true,
  "description": "Atlas: enterprise AI-powered talent management platform (monorepo)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/contracts",
    "packages/platform",
    "packages/scoring",
    "packages/proctor-sdk",
    "services/*",
    "packages/api-clients",
    "infra/gateway",
    "apps/web"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json && tsc -p e2e/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "clean": "tsc -b tsconfig.build.json --clean",
    "migrate": "node packages/platform/dist/db/migrate-cli.js",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-pgvector": "0.0.16",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@swc/core": "1.16.21",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "3.2.7",
    "aws-sdk-client-mock": "4.1.0",
    "eslint": "9.39.5",
    "ioredis-mock": "8.13.1",
    "prettier": "3.9.10",
    "selfsigned": "5.5.0",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7",
    "xml-crypto": "6.3.3"
  }
}
