# ArcFace r100 (identity embedding, 512-d), ONNX, 112x112 aligned RGB in [-1, 1].
name: "arcface"
platform: "onnxruntime_onnx"
max_batch_size: 32
input [ { name: "input", data_type: TYPE_FP32, dims: [ 3, 112, 112 ] } ]
output [ { name: "embedding", data_type: TYPE_FP32, dims: [ 512 ] } ]
dynamic_batching { max_queue_delay_microseconds: 10000 }
instance_group [ { kind: KIND_GPU, count: 1 } ]
